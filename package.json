    "test:deck": "node --test tests/deck-schema.test.mjs tests/deck-compile.test.mjs",
    "test:pdf": "node --import ./tests/register-loader.mjs --test tests/pdf-export.test.mjs",
    "test:pdf:route": "node --import ./tests/register-loader.mjs --experimental-test-module-mocks --test tests/export-pdf-route.test.mjs",
    "test:download": "node --import ./tests/register-loader.mjs --test tests/download-helper.test.mjs",
    "test:pptx": "node --import ./tests/register-loader.mjs --test tests/pptx-export.test.mjs",
    "test:pptx:route": "node --import ./tests/register-loader.mjs --experimental-test-module-mocks --test tests/export-pptx-route.test.mjs",
    "test:storage": "node --import ./tests/register-loader.mjs --test tests/export-storage.test.mjs",
    "test:sandbox": "node --test tests/sandbox.test.mjs"
